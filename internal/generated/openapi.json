{
  "openapi": "3.1.0",
  "info": {"title": "Spaniel API", "version": "0.1.0", "description": "Local, read-only observability API for traces, logs, metrics, dashboards, alerts, and schema discovery."},
  "servers": [{"url": "/", "description": "Current Spaniel instance"}],
  "paths": {
    "/api/health": {"get": {"summary": "Health check", "responses": {"200": {"description": "Spaniel is available"}}}},
    "/api/database-schema": {"get": {"summary": "Database schema catalog", "description": "Versioned allowlist of queryable telemetry views.", "responses": {"200": {"description": "Schema catalog"}}}},
    "/api/query-catalog": {"get": {"summary": "Query sample catalog", "parameters": [{"name": "signal", "in": "query", "schema": {"type": "string"}}, {"name": "q", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"description": "SQL recipes"}}}},
    "/api/traces": {"get": {"summary": "List traces", "responses": {"200": {"description": "Trace page"}}}},
    "/api/spans": {"get": {"summary": "List spans", "responses": {"200": {"description": "Span page"}}}},
    "/api/logs": {"get": {"summary": "List logs", "responses": {"200": {"description": "Log page"}}}},
    "/api/metrics": {"get": {"summary": "List metrics", "responses": {"200": {"description": "Metric page"}}}},
    "/api/dashboards": {"get": {"summary": "List dashboards", "responses": {"200": {"description": "Dashboards"}}}, "post": {"summary": "Create a dashboard", "responses": {"200": {"description": "Created dashboard"}}}},
    "/api/alerts": {"get": {"summary": "List alert rules", "responses": {"200": {"description": "Alert rules"}}}, "post": {"summary": "Create an alert rule", "responses": {"200": {"description": "Created alert rule"}}}}
  }
}
