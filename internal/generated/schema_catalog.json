      "samples": [
        {
          "id": "span-count-over-time",
          "title": "Span count over time",
          "display_type": "time_series",
          "sql": "SELECT (start_ns // 60000000000) * 60000000000 AS timestamp_ns, count(*) AS value FROM telemetry_spans WHERE session_id = $session_id GROUP BY 1 ORDER BY 1",
          "explanation": "A one-minute request volume series scoped to the active session."
        },
        {
          "id": "slow-spans",
          "title": "Slow spans",
          "display_type": "table",
          "sql": "SELECT service_name, name, duration_ns / 1000000.0 AS duration_ms, trace_id, span_id FROM telemetry_spans WHERE session_id = $session_id ORDER BY duration_ns DESC LIMIT 30",
          "explanation": "The slowest spans with links back to their trace."
        }
      ]
