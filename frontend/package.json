{
  "name": "spaniel-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:openapi": "openapi-typescript ../api/openapi.json -o src/generated/openapi.ts && oxfmt --write src/generated/openapi.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
